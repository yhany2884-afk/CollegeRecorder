<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="رجوع" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#EEF2F5"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textColor="#8D98A3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/play"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="تشغيل" />

        <Button
            android:id="@+id/share"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="تصدير" />

        <Button
            android:id="@+id/delete"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="حذف" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/tabText"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="النص" />

        <Button
            android:id="@+id/tabSummary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="التلخيص" />

        <Button
            android:id="@+id/tabNotes"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="ملاحظات" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/bodyScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="#EEF2F5"
            android:textSize="16sp" />
    </ScrollView>

    <EditText
        android:id="@+id/notes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:gravity="top"
        android:hint="اكتب ملاحظاتك هنا"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="#EEF2F5"
        android:textColorHint="#8D98A3"
        android:visibility="gone" />
</LinearLayout>
